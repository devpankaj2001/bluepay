PORT=1977
NODE_ENV=development
MONGO_URI=
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_RETRY_DELAY_MS=5000
MONGO_READY_TIMEOUT_MS=10000
JWT_SECRET=
ADMIN_SEED_PASSWORD=
WEBHOOK_ENCRYPTION_KEY=
OTP_API_KEY=
OTP_SENDER_ID=
EMAIL_USER=
EMAIL_PASS=

# Public URL of this API (used to build CCAvenue's redirect/cancel URL)
BACKEND_URL=http://localhost:1977
# Public URL of the frontend (used to send the browser back after payment)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ALLOWED_ORIGINS=
REQUEST_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000

# Rate limits (override per deployment; values are requests per window)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CREDENTIALS_WINDOW_MS=900000
RATE_LIMIT_CREDENTIALS_MAX=30
RATE_LIMIT_MERCHANT_API_WINDOW_MS=60000
RATE_LIMIT_MERCHANT_API_MAX=120
RATE_LIMIT_WEBHOOK_CONFIG_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_CONFIG_MAX=30

# CCAvenue (Step 11 - Add Money via CCAvenue)
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_API_URL=https://test.ccavenue.com/transaction/transaction.do?command=initiateTransaction
CCAVENUE_RESPONSE_URL=

# --- Kotak Bank Payout Provider (Step 10) ---
# "mock" (default) uses services/bank/kotak/mockKotakAdapter.js - safe for
# dev/testing, no real bank calls, no real credentials needed.
#
# "live" requires:
#   1. The official Kotak payout API/UAT documentation (not present in
#      this project - see services/bank/kotak/kotakClient.js).
#   2. services/bank/kotak/kotakClient.js implemented against that spec.
#   3. The KOTAK_* values below filled in with real values from Kotak.
#
# The variable names below are placeholders for the kind of values a bank
# payout API commonly requires (client credentials, an account to debit,
# and mTLS cert/key paths) - they are NOT confirmed against Kotak's actual
# spec and may need to change once that spec is available.
PAYOUT_PROVIDER_MODE=mock
# Live-only values (spec v5.4). Token/payment/status URLs are derived from the base URL
# (override with KOTAK_TOKEN_URL / KOTAK_PAYMENT_URL / KOTAK_STATUS_URL if needed).
KOTAK_BASE_URL=https://apigwuat.kotak.com:8443
KOTAK_CLIENT_ID=
KOTAK_CLIENT_SECRET=
KOTAK_CLIENT_CODE=
KOTAK_MSG_SOURCE=
KOTAK_COMPANY_ID=
KOTAK_MY_PROD_CODE=
KOTAK_ACCOUNT_NUMBER=
KOTAK_BANK_CD_IND=
KOTAK_PAYMODE_MODE=omit

# Bulk Payout (BullMQ + Redis). Defaults to enabled if unset - only set to
# false in environments (e.g. local dev without Redis running) where the
# feature should be temporarily switched off. Never set to false here in a
# production template; each environment's own .env decides this.
BULK_PAYOUT_ENABLED=true
